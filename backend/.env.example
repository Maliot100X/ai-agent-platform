# AI Provider
MODEL_PROVIDER=vercel
MODEL_NAME=deepseek/deepseek-v3.2

# Vercel AI Gateway
VERCEL_API_KEY=your_vercel_api_key

# Fireworks (optional)
FIREWORKS_API_KEY=your_fireworks_key

# Gemini (optional)
GEMINI_API_KEY=your_gemini_key

# Ollama (local only)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Compatible (optional)
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Solana / DeFi
BIRDEYE_API_KEY=your_birdeye_key
HELIUS_API_KEY=your_helius_key
HELIUS_API_KEY_2=
HELIUS_API_KEY_3=

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_user_id
TELEGRAM_CHANNEL_ID=your_channel_id

# Database (optional for serverless)
DATABASE_URL=postgresql+asyncpg://agent_user:agent_pass@localhost:5432/agent_platform
DATABASE_SYNC_URL=postgresql://agent_user:agent_pass@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this_to_a_random_secret_key
CORS_ORIGINS=*

# Dashboard
DASHBOARD_URL=http://localhost:3000

# Observability
LOG_LEVEL=INFO
ENABLE_METRICS=true
