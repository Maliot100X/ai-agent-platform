[Unit]
Description=AI Agent Platform - Agent Runtime
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/ai-agent-platform
ExecStart=/opt/ai-agent-platform/venv/bin/python -m backend.agents.runtime
Restart=always
RestartSec=10
Environment=PYTHONPATH=/opt/ai-agent-platform
EnvironmentFile=/opt/ai-agent-platform/backend/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-runtime

[Install]
WantedBy=multi-user.target
